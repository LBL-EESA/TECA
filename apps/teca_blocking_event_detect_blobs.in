#!/usr/bin/env python@TECA_PYTHON_VERSION@

# This application implements a part of the TempestExtremes pipeline to detect
# blocking events via connected component labeling of geopotential height
# anomalies described in:
#   Ullrich, P. A., Zarzycki, C. M., McClenny, E. E., Pinheiro, M. C.,
#   Stansfield, A. M., and Reed, K. A.: TempestExtremes v2.1: a community
#   framework for feature detection, tracking, and analysis in large datasets,
#   Geosci. Model Dev., 14, 5023–5048, https://doi.org/10.5194/gmd-14-5023-2021,
#   2021.
#
# This application implements "3.6.2 Step 2: identify regions of
# geopotential above the blocking threshold" of the paper.
#
# Geopotential height anomalies are derived by comparing the geopotential
# height at 500 hPa to a daily threshold value. The threshold values are
# provided in a separate data set containing one year of daily data.
# The application uses TECA to read the input data, detect  geopotential
# height anomalies, perform connected component labeling, filter the labeled
# components by area, and write the results to a set of NetCDF files.
#
# NOTE: Differing from TempestExtremes, this application already writes out
# connected component ids rather than a binary mask (unless the option
# --discard_unique_region_ids is specified, in which case it will write a
# binary mask like DetectBlobs). Computing connected components is required
# to filter by area and saving connected component ids saves another expensive
# connected component computation for tracking in the next step.

import argparse
import sys
from typing import Optional, List

try:
    from mpi4py import MPI
    comm = MPI.COMM_WORLD
    rank = comm.Get_rank()
except ImportError:
    comm = None
    rank = 0

import teca

from teca_blocking_event_helper_functions import (
    generate_day_index_list,
    validate_thresholds_file,
    report_error_and_exit
)

from teca_blocking_event_operations import (
    DetectGeopotentialHeightAnomalyOp,
    BinarizeComponentIdsOp
)

# Default detection parameters for blocking events
# (according to Ullrich et al. 2021)
DEFAULT_PRESSURE_LEVEL = 500.0  # default pressure level (hPa)
DEFAULT_MIN_LATITUDE = 25.0     # default minimum absolute latitude
DEFAULT_MAX_LATITUDE = 75.0     # default maximum absolute latitude
DEFAULT_MIN_AREA = 1.0e6        # default minimum area (sq. km)

# Default variable names
DEFAULT_X_AXIS_VARIABLE = 'lon'
DEFAULT_Y_AXIS_VARIABLE = 'lat'
DEFAULT_T_AXIS_VARIABLE = 'time'

class teca_blocking_event_detect_blobs:
    """
    A class that encapsulates the blocking event detection pipeline.

    This class provides a reusable component for detecting blocking events
    via connected component labeling of geopotential height anomalies.
    It can accept input from any TECA algorithm and provide output to any
    TECA algorithm.
    """
    def __init__(self):
        """
        Initialize the blocking event detection pipeline.

        Creates a new instance with default parameter values. All configuration
        must be set using the setter methods before building the pipeline.
        """
        # Placeholders for input node and pipeline
        self.input_node = None
        self.pipeline_tail = None

        self.thresholds_reader = None
        self.thresholds_x_axis_variable = DEFAULT_X_AXIS_VARIABLE
        self.thresholds_y_axis_variable = DEFAULT_Y_AXIS_VARIABLE
        self.thresholds_t_axis_variable = DEFAULT_T_AXIS_VARIABLE

        self.geopotential_height_variable = None
        self.geopotential_height_threshold_variable = None

        self.discard_unique_region_ids = False

        # Use module-level constants for default detection parameters
        self.pressure_level = DEFAULT_PRESSURE_LEVEL
        self.min_latitude = DEFAULT_MIN_LATITUDE
        self.max_latitude = DEFAULT_MAX_LATITUDE
        self.min_area = DEFAULT_MIN_AREA

        # Names for derived variables
        self.mask_varname = 'geopotential_height_anomaly_mask'
        self.component_varname = 'blocking_event_id'
        self.binarized_component_varname = 'blocking_event_mask'

    def _ensure_pipeline_not_built(self) -> None:
        """
        Ensure that the pipeline has not been built yet.

        Raises
        ------
        RuntimeError
            If the pipeline has already been built
        """
        if self.pipeline_tail is not None:
            raise RuntimeError(
                "Parameters can only be set before pipeline is built.")

    def set_thresholds_x_axis_variable(self, x_axis_variable: str) -> None:
        """
        Set the x axis variable name for the thresholds reader.

        Parameters
        ----------
        x_axis_variable : str
            Name of x axis variable
        """
        self._ensure_pipeline_not_built()
        if not x_axis_variable:
            raise ValueError("x_axis_variable cannot be empty")
        self.thresholds_x_axis_variable = x_axis_variable

    def set_thresholds_y_axis_variable(self, y_axis_variable: str) -> None:
        """
        Set the y axis variable name for the thresholds reader.

        Parameters
        ----------
        y_axis_variable : str
            Name of y axis variable
        """
        self._ensure_pipeline_not_built()
        if not y_axis_variable:
            raise ValueError("y_axis_variable cannot be empty")
        self.thresholds_y_axis_variable = y_axis_variable

    def set_thresholds_t_axis_variable(self, t_axis_variable: str) -> None:
        """
        Set the t axis variable name for the thresholds reader.

        Parameters
        ----------
        t_axis_variable : str
            Name of t axis variable
        """
        self._ensure_pipeline_not_built()
        if not t_axis_variable:
            raise ValueError("t_axis_variable cannot be empty")
        self.thresholds_t_axis_variable = t_axis_variable

    def set_geopotential_height_variable(self, variable_name: str) -> None:
        """
        Set the geopotential height variable name.

        Parameters
        ----------
        variable_name : str
            Name of geopotential height variable
        """
        if not variable_name:
            raise ValueError("variable_name cannot be empty")
        self.geopotential_height_variable = variable_name

    def set_geopotential_height_threshold_variable(self, variable_name: str) -> None:
        """
        Set the geopotential height threshold variable name.

        Parameters
        ----------
        variable_name : str
            Name of geopotential height threshold variable
        """
        if not variable_name:
            raise ValueError("variable_name cannot be empty")
        self.geopotential_height_threshold_variable = variable_name

    def set_pressure_level(self, pressure_level: float) -> None:
        """
        Set the pressure level for blocking event detection.

        Parameters
        ----------
        pressure_level : float
            Pressure level in hPa
        """
        self._ensure_pipeline_not_built()
        if pressure_level <= 0:
            raise ValueError(
                f"pressure_level must be positive, got {pressure_level}")
        self.pressure_level = pressure_level

    def set_min_latitude(self, min_latitude: float) -> None:
        """
        Set the minimum absolute latitude for blocking event detection.

        Parameters
        ----------
        min_latitude : float
            Minimum absolute latitude in degrees
        """
        self._ensure_pipeline_not_built()
        if not (0 <= min_latitude <= 90):
            raise ValueError(
                f"min_latitude must be in range [0, 90], got {min_latitude}")
        self.min_latitude = min_latitude

    def set_max_latitude(self, max_latitude: float) -> None:
        """
        Set the maximum absolute latitude for blocking event detection.

        Parameters
        ----------
        max_latitude : float
            Maximum absolute latitude in degrees
        """
        self._ensure_pipeline_not_built()
        if not (0 <= max_latitude <= 90):
            raise ValueError(
                f"max_latitude must be in range [0, 90], got {max_latitude}")
        self.max_latitude = max_latitude

    def set_min_area(self, min_area: float) -> None:
        """
        Set the minimum area for blocking event detection.

        Parameters
        ----------
        min_area : float
            Minimum area in square kilometers
        """
        self._ensure_pipeline_not_built()
        if min_area <= 0:
            raise ValueError(f"min_area must be positive, got {min_area}")
        self.min_area = min_area

    def set_thresholds_filename(self, thresholds_filename: str) -> None:
        """
        Set the thresholds filename for the blocking event detection pipeline.
        NOTE: Set either this or set_thresholds_regex(), not both.

        Parameters
        ----------
        thresholds_filename : str
            Path to the thresholds data file
        """
        self._ensure_pipeline_not_built()
        if self.thresholds_reader is not None:
            raise RuntimeError(
                "Thresholds reader can only be set once.")
        if not thresholds_filename:
            raise ValueError("thresholds_filename cannot be empty")
        self.thresholds_reader = teca.teca_multi_cf_reader.New()
        self.thresholds_reader.set_input_file(thresholds_filename)

    def set_thresholds_regex(self, thresholds_regex: str) -> None:
        """
        Set the thresholds regex for the blocking event detection pipeline.
        NOTE: Set either this or set_thresholds_filename(), not both.

        Parameters
        ----------
        thresholds_regex : str
            Regex pattern to identify thresholds data files
        """
        self._ensure_pipeline_not_built()
        if self.thresholds_reader is not None:
            raise RuntimeError(
                "Thresholds reader can only be set once.")
        if not thresholds_regex:
            raise ValueError("thresholds_regex cannot be empty")
        self.thresholds_reader = teca.teca_cf_reader.New()
        self.thresholds_reader.set_files_regex(thresholds_regex)

    def set_discard_unique_region_ids(self, discard: bool) -> None:
        """
        Set whether to discard unique region ids and output a binary mask.

        Parameters
        ----------
        discard : bool
            If True, output a binary mask instead of unique region ids
        """
        self._ensure_pipeline_not_built()
        self.discard_unique_region_ids = discard

    def get_blocking_event_variable_name(self) -> str:
        """
        Get the name of the blocking event variable.

        NOTE: This name of the variable depends on whether unique region ids
        are being discarded.

        Returns
        -------
        variable_name : str
            Name of the blocking event variable
        """
        if self.discard_unique_region_ids:
            return self.binarized_component_varname
        else:
            return self.component_varname

    def get_mask_variable_name(self) -> str:
        """
        Get the name of the geopotential height anomaly mask variable.

        Returns
        -------
        variable_name : str
            Name of the mask variable
        """
        return self.mask_varname

    def set_input_node(self, input_node: 'teca.teca_algorithm') -> None:
        """
        Set the input node for the blocking event detection pipeline.

        IMPORTANT: Differing from typical TECA algorithms, we need an
        input node and not an input port because we need to be able to
        call update_metadata() on the input node to get metadata for
        building the pipeline.

        Parameters
        ----------
        input_node : teca.teca_algorithm
            Input node for the pipeline
        """
        self._ensure_pipeline_not_built()
        if input_node is None:
            raise ValueError("input_node cannot be None")
        self.input_node = input_node

    def get_output_node(self) -> 'teca.teca_algorithm':
        """
        Get the output node of the blocking event detection pipeline.

        Returns
        -------
        output_node : teca.teca_algorithm
            Output node of the pipeline
        """
        if self.pipeline_tail is None:
            self._build_detection_pipeline()
        return self.pipeline_tail

    def get_output_port(self) -> 'teca.teca_algorithm.OutputPort':
        """
        Get the output port of the blocking event detection pipeline.

        Returns
        -------
        output_port : teca.teca_algorithm.OutputPort
            Output port of the pipeline
        """
        if self.pipeline_tail is None:
            self._build_detection_pipeline()
        return self.pipeline_tail.get_output_port()

    def _configure_thresholds_reader(self):
        """
        Configure the thresholds reader with axis variables and periodicity.
        """
        self.thresholds_reader.set_x_axis_variable(self.thresholds_x_axis_variable)
        self.thresholds_reader.set_y_axis_variable(self.thresholds_y_axis_variable)
        self.thresholds_reader.set_t_axis_variable(self.thresholds_t_axis_variable)
        self.thresholds_reader.set_periodic_in_x(True)
        # Note: teca_cf_reader has set_periodic_in_y(),
        # but teca_multi_cf_reader does not
        if hasattr(self.thresholds_reader, 'set_periodic_in_y'):
            self.thresholds_reader.set_periodic_in_y(False)

    def _get_and_validate_metadata(self, input_node, required_vars=None):
        """
        Get metadata and validate it.

        Parameters
        ----------
        input_node : teca.teca_algorithm
            Node from teca pipeline to get metadata from
        required_vars : list of str, optional
            List of required variable names for validation
            If None, no variable validation is performed (default: None)

        Returns
        -------
        metadata : teca_metadata
            Validated metadata object
        """
        try:
            metadata = input_node.update_metadata()
        except Exception as e:
            raise RuntimeError(
                f'Failed to read metadata from input node. '
                f'This may indicate an issue with the input data source. Error: {e}')

        # Validate required variables for input data
        if required_vars is not None:
            try:
                available_vars = metadata.get('variables')
            except Exception:  # teca_metadata may raise various exceptions - catch all
                available_vars = []
            missing_vars = [var for var in required_vars if var not in available_vars]
            if missing_vars:
                raise RuntimeError(
                    f'Required variable(s) {missing_vars} not found in input. '
                    f'Available variables: {available_vars}. '
                    f'Please check that your input contains the required variables.')

        return metadata

    def _create_slice_extractor(self, input_md, input_node):
        """
        Create and configure a slice source for extracting pressure level.

        Parameters
        ----------
        args : argparse.Namespace
            Contains pressure_level parameter

        Returns
        -------
        source : teca.teca_cartesian_mesh_regrid
            Configured mesh regrid for extracting pressure level slice
        """
        input_coords = input_md['coordinates']
        x = input_coords['x']
        y = input_coords['y']
        t = input_coords['t']
        bounds = input_md['bounds']

        slice_source = teca.teca_cartesian_mesh_source.New()
        slice_source.set_bounds([
            bounds[0], bounds[1], bounds[2], bounds[3],
            self.pressure_level, self.pressure_level, float(t[0]), float(t[-1])])
        slice_source.set_whole_extents([
            0, x.size-1, 0, y.size-1, 0, 0, 0, t.size-1])
        slice_source.set_periodic_in_x(True)
        slice_source.set_periodic_in_y(False)
        calendar = input_md['attributes']['time']['calendar']
        units = input_md['attributes']['time']['units']
        slice_source.set_calendar(calendar, units)

        extract_slice = teca.teca_cartesian_mesh_regrid.New()
        extract_slice.set_interpolation_mode_linear()
        extract_slice.set_input_connection(0, slice_source.get_output_port())
        extract_slice.set_input_connection(1, input_node.get_output_port())

        return extract_slice

    def _create_thresholds_synchronization(self, input_md, input_node):
        """
        Create and configure time synchronization for thresholds with input
        data. This assumes that the thresholds data contains one year of daily
        data (no leap year) and reindexes the thresholds data to match the
        time steps in the input data as well as overriding the time metadata to
        match the input data.

        Parameters
        ----------
        input_md : teca_metadata
            Metadata object from input data to synchronize with
        input_node : teca.teca_algorithm
            Input connection with thresholds data to synchronize

        Returns
        -------
        sync : teca.teca_python_algorithm
            Configured time synchronization pipeline
        """
        # Sync thresholds data with input data time steps
        reindex_thresholds = teca.teca_temporal_index_select.New()
        reindex_thresholds.set_input_connection(
            input_node.get_output_port())
        day_index_list = generate_day_index_list(input_md)
        reindex_thresholds.set_indices(day_index_list)

        time_override = teca.teca_time_metadata_override.New()
        time_override.set_time_values(input_md['coordinates']['t'])
        time_override.set_calendar(input_md['attributes']['time']['calendar'])
        time_override.set_units(input_md['attributes']['time']['units'])
        time_override.set_input_connection(reindex_thresholds.get_output_port())

        return time_override

    def _create_anomaly_detector(self, input_node, mesh_dim_active):
        """
        Create and configure geopotential height anomaly detection pipeline.

        Parameters
        ----------
        input_node : teca.teca_algorithm
            Input connection with required variables (e.g., mesh join output)
        input_md : teca_metadata
            Metadata object for input data to synchronize with

        Returns
        -------
        detector : teca.teca_derived_quantity
            Configured anomaly detector
        """
        if self.geopotential_height_variable is None:
            raise RuntimeError(
                "Geopotential height variable name must be set before creating anomaly detector. "
                "Call set_geopotential_height_variable() to configure.")
        if self.geopotential_height_threshold_variable is None:
            raise RuntimeError(
                "Geopotential height threshold variable name must be set before creating anomaly detector. "
                "Call set_geopotential_height_threshold_variable() to configure.")
        detector = teca.teca_derived_quantity.New()
        detector.set_operation_name('detect_geopotential_height_anomaly')
        detector.set_input_connection(input_node.get_output_port())

        dependent_vars = [
            self.geopotential_height_variable,
            self.geopotential_height_threshold_variable
        ]
        detector.set_dependent_variables(dependent_vars)

        out_atts = teca.teca_array_attributes(
            teca.teca_char_array_code.get(), teca.teca_array_attributes.point_centering,
            0, mesh_dim_active, 'unitless',
            self.mask_varname,
            'a binary mask indicating whether location is geopotential height anomaly',
            None)
        detector.append_derived_variable(self.mask_varname, out_atts)

        detector_op = DetectGeopotentialHeightAnomalyOp(
            self.geopotential_height_variable,
            self.geopotential_height_threshold_variable,
            self.mask_varname)
        detector.set_execute_callback(detector_op)

        return detector

    def _create_latitude_range_filter(self, input_node):
        """
        Create and configure latitude range filter.

        Parameters
        ----------
        input_node : teca.teca_algorithm
            Input connection

        Returns
        -------
        lat_filter : teca.teca_latitude_range_filter
            Configured latitude range filter
        """
        latitude_range_filter = teca.teca_latitude_range_filter.New()
        latitude_range_filter.set_input_connection(input_node.get_output_port())
        latitude_range_filter.set_filtered_variables([self.mask_varname])
        latitude_range_filter.set_min_lat(self.min_latitude)
        latitude_range_filter.set_max_lat(self.max_latitude)
        latitude_range_filter.set_variable_postfix('')

        return latitude_range_filter

    def _create_component_area_filter(self, input_node):
        """
        Create connected component detection and area filtering pipeline.

        Parameters
        ----------
        input_node : teca.teca_algorithm
            Input connection
        segmentation_varname : str
            Name of segmentation variable

        Returns
        -------
        area_filter : teca.teca_component_area_filter
            Final component filter
        """

        # Connected component labeling
        connected_components = teca.teca_connected_components.New()
        connected_components.set_input_connection(input_node.get_output_port())
        connected_components.set_segmentation_variable(self.mask_varname)
        connected_components.set_component_variable(self.component_varname)

        # Compute component areas
        area_calc = teca.teca_2d_component_area.New()
        area_calc.set_input_connection(connected_components.get_output_port())
        area_calc.set_component_variable(self.component_varname)

        # Filter by minimum area
        area_filter = teca.teca_component_area_filter.New()
        area_filter.set_input_connection(area_calc.get_output_port())
        area_filter.set_component_variable(self.component_varname)
        area_filter.set_low_area_threshold(self.min_area)

        return area_filter

    def _create_binarizer(self, input_node, mesh_dim_active):
        """
        Create and configure component ID binarization pipeline.

        Parameters
        ----------
        input_node : teca.teca_algorithm
            Input connection

        Returns
        -------
        binarizer : teca.teca_derived_quantity
            Configured binarization operator
        """
        binarize_op = teca.teca_derived_quantity.New()
        binarize_op.set_operation_name('binarize_component_ids')
        binarize_op.set_input_connection(input_node.get_output_port())
        binarize_op.set_dependent_variables([self.component_varname])

        # Configure output array attributes
        out_atts = teca.teca_array_attributes(
            teca.teca_char_array_code.get(), teca.teca_array_attributes.point_centering,
            0, mesh_dim_active, 'unitless',
            self.binarized_component_varname,
            'a binary mask indicating blocking event candidates',
            None)
        binarize_op.append_derived_variable(self.binarized_component_varname, out_atts)

        # Set the binarization callback
        binarize_callback = BinarizeComponentIdsOp(self.component_varname, self.binarized_component_varname)
        binarize_op.set_execute_callback(binarize_callback)

        return binarize_op

    def _build_detection_pipeline(self):
        """
        Build the blocking event detection pipeline.
        """
        if self.input_node is None:
            raise RuntimeError(
                "Input connection must be set before building the pipeline. "
                "Call set_input_node() to configure the input data source.")
        if self.thresholds_reader is None:
            raise RuntimeError(
                "Thresholds reader must be set before building the pipeline. "
                "Call set_thresholds_filename() or set_thresholds_regex() to configure.")
        if self.geopotential_height_variable is None:
            raise RuntimeError(
                "Geopotential height variable name must be set before building the pipeline. "
                "Call set_geopotential_height_variable() to configure.")
        if self.geopotential_height_threshold_variable is None:
            raise RuntimeError(
                "Geopotential height threshold variable name must be set before building the pipeline. "
                "Call set_geopotential_height_threshold_variable() to configure.")

        # Configure thresholds reader
        self._configure_thresholds_reader()

        # Normalize thresholds coordinates
        normalize_threshold_coordinates = teca.teca_normalize_coordinates.New()
        normalize_threshold_coordinates.set_input_connection(
            self.thresholds_reader.get_output_port())

        # Get and validate metadata
        input_md = self._get_and_validate_metadata(
            self.input_node,
            [self.geopotential_height_variable])
        thresholds_md = self._get_and_validate_metadata(
            normalize_threshold_coordinates,
            [self.geopotential_height_threshold_variable])

        # Validate thresholds file contains one year of daily data
        if not validate_thresholds_file(thresholds_md, rank):
            raise RuntimeError(
                "Thresholds file validation failed: the thresholds data must contain "
                "exactly one year of daily data (365 time steps, no leap year). "
                "Please verify your thresholds file.")

        # Create pressure level slice source and extract slice from input data
        extract_slice = self._create_slice_extractor(
            input_md, self.input_node)

        # Get mesh_dim_active from input metadata (note this must be done after
        # extracting the slice to account for the removed z-axis)
        try:
            input_md = extract_slice.update_metadata()
        except Exception as e:
            raise RuntimeError(
                f'Failed to update metadata after extracting pressure level slice. '
                f'Error: {e}')

        in_atts = teca.teca_array_attributes(
            input_md['attributes'][self.geopotential_height_variable])
        mesh_dim_active = in_atts.mesh_dim_active

        # Sync thresholds data with input data time steps
        threshold_sync = self._create_thresholds_synchronization(
            input_md, normalize_threshold_coordinates)

        # Combine the two meshes
        mesh_join = teca.teca_mesh_join.New()
        mesh_join.set_input_connection(0, extract_slice.get_output_port())
        mesh_join.set_input_connection(1, threshold_sync.get_output_port())

        # Detect geopotential height anomalies
        anomaly_detector = self._create_anomaly_detector(
            mesh_join, mesh_dim_active)

        # Filter by latitude range
        latitude_range_filter = self._create_latitude_range_filter(
            anomaly_detector)

        # Perform connected component labeling and area filtering
        component_area_filter = self._create_component_area_filter(
            latitude_range_filter)

        # Binarize component IDs if requested
        if self.discard_unique_region_ids:
            binarizer = self._create_binarizer(
                component_area_filter, mesh_dim_active)
            self.pipeline_tail = binarizer
        else:
            self.pipeline_tail = component_area_filter

def create_argument_parser():
    """
    Create and configure the command-line argument parser.

    Returns
    -------
    parser : argparse.ArgumentParser
        Configured argument parser
    """
    parser = argparse.ArgumentParser(
        formatter_class=lambda prog: argparse.ArgumentDefaultsHelpFormatter(
                           prog, max_help_position=4, width=100))

    # Input data options (mutually exclusive)
    input_group = parser.add_mutually_exclusive_group(required=True)
    input_group.add_argument('--input_file', type=str,
        help='a teca_multi_cf_reader configuration file identifying the set'
             ' of NetCDF CF2 files to process. When present data is read'
             ' using the teca_multi_cf_reader. Use one of either --input_file'
             ' or --input_regex.')

    input_group.add_argument('--input_regex', type=str,
        help='a teca_cf_reader regex identifying the'
             ' set of NetCDF CF2 files to process. When present data is read'
             ' using the teca_cf_reader. Use one of either --input_file or '
             ' --input_regex.')

    # Thresholds data options (mutually exclusive)
    threshold_group = parser.add_mutually_exclusive_group(required=True)
    threshold_group.add_argument('--thresholds_file', type=str,
        help='a teca_multi_cf_reader configuration file identifying the set'
             ' of NetCDF CF2 files with thresholds for blocking events. When'
             ' present data is read using the teca_multi_cf_reader. Use one'
             ' of either --thresholds_file or --thresholds_regex.')

    threshold_group.add_argument('--thresholds_regex', type=str,
        help='a teca_cf_reader regex identifying the'
             ' set of NetCDF CF2 files thresholds for blocking events. When'
             ' present data is read  using the teca_cf_reader. Use one of'
             ' either --thresholds_file or --thresholds_regex.')

    # Variable names
    parser.add_argument('--geopotential_height_variable', type=str,
        required=False, default='H',
        help='name of variable with geopotential height (default: H)')

    parser.add_argument('--geopotential_height_threshold_variable', type=str,
        required=False, default='threshold_H',
        help='name of variable with geopotential height threshold (default:'
             'threshold_H)')

    parser.add_argument('--x_axis_variable', type=str,
        default=DEFAULT_X_AXIS_VARIABLE, required=False,
        help=f'name of x coordinate variable (default: {DEFAULT_X_AXIS_VARIABLE})')

    parser.add_argument('--y_axis_variable', type=str,
        default=DEFAULT_Y_AXIS_VARIABLE, required=False,
        help=f'name of y coordinate variable (default: {DEFAULT_Y_AXIS_VARIABLE})')

    parser.add_argument('--z_axis_variable', type=str,
        default='lev', required=False,
        help='name of z coordinate variable (default: lev)')

    parser.add_argument('--t_axis_variable', type=str,
        default=DEFAULT_T_AXIS_VARIABLE, required=False,
        help=f'time dimension name (default: {DEFAULT_T_AXIS_VARIABLE})')

    # Output configuration
    parser.add_argument('--output_file', type=str, required=True,
        help='A path and file name pattern for the output NetCDF files. %%t%% is'
             ' replaced with a human readable date and time corresponding to the'
             ' time of the first time step in the file. Use --date_format to change'
             ' the formatting')

    parser.add_argument('--file_layout', type=str, default='monthly',
        help='Selects the size and layout of the set of output files. May be one'
             ' of number_of_steps, daily, monthly, seasonal, or yearly. Files are'
             ' structured such that each file contains one of the selected'
             ' interval. For the number_of_steps option use --steps_per_file.')

    parser.add_argument('--steps_per_file', type=int, required=False, default=128,
        help='number of time steps per output file (default: 128)')

    parser.add_argument('--date_format', type=str, required=False,
        help='A strftime format used when encoding dates into the output file'
             ' names (%%F-%%HZ). %%t%% in the file name is replaced with date/time'
             ' of the first time step in the file using this format specifier.')

    parser.add_argument('--first_step', type=int, default=0, required=False,
        help='first time step to process (default: 0)')

    parser.add_argument('--last_step', type=int, default=-1, required=False,
        help='last time step to process. -1 means entire dataset (default: -1)')

    parser.add_argument('--calendar', type=str, required=False,
        help='time calendar')

    parser.add_argument('--t_units', type=str, required=False,
        help='time unit')

    parser.add_argument('--save_mask', action='store_true',
        help='save the geopotential height anomaly mask to the output file')

    parser.add_argument('--discard_unique_region_ids', action='store_true',
        help='if specified, binarize the output, i.e., write a mask that '
             'contains one if location is blocking event candidate, otherwise '
             'zero')

    # Detection parameters
    parser.add_argument('--pressure_level', type=float,
        default=DEFAULT_PRESSURE_LEVEL, required=False,
        help=f'pressure level in hPa for blocking detection '
             f'(default: {DEFAULT_PRESSURE_LEVEL} hPa)')

    parser.add_argument('--min_latitude', type=float,
        default=DEFAULT_MIN_LATITUDE, required=False,
        help=f'minimum absolute latitude for blocking detection (equatorward, '
             f'applies to both hemispheres, default: {DEFAULT_MIN_LATITUDE})')

    parser.add_argument('--max_latitude', type=float,
        default=DEFAULT_MAX_LATITUDE,required=False,
        help=f'maximum absolute latitude for blocking detection (poleward, '
             f'applies to both hemispheres, default: {DEFAULT_MAX_LATITUDE})')

    parser.add_argument('--min_area', type=float, default=1.0e6,
        required=False,
        help=f'minimum component area in square kilometers for blocking events'
             f' (default: {DEFAULT_MIN_AREA})')

    # Threading options
    parser.add_argument('--n_threads', type=int, default=-1,
        required=False,
        help='number of threads for the writer. -1 means one thread per physical'
             ' core (default: -1)')

    return parser


def validate_arguments(args, rank):
    """
    Validate command-line arguments for consistency.

    Parameters
    ----------
    args : argparse.Namespace
        Parsed command-line arguments
    rank : int
        MPI rank for conditional error reporting
    """
    # Validate variable names are not empty
    if not args.geopotential_height_variable or not args.geopotential_height_variable.strip():
        report_error_and_exit('geopotential_height_variable cannot be empty', rank)

    if not args.geopotential_height_threshold_variable or not args.geopotential_height_threshold_variable.strip():
        report_error_and_exit('geopotential_height_threshold_variable cannot be empty', rank)

    if not args.x_axis_variable or not args.x_axis_variable.strip():
        report_error_and_exit('x_axis_variable cannot be empty', rank)

    if not args.y_axis_variable or not args.y_axis_variable.strip():
        report_error_and_exit('y_axis_variable cannot be empty', rank)

    if not args.z_axis_variable or not args.z_axis_variable.strip():
        report_error_and_exit('z_axis_variable cannot be empty', rank)

    if not args.t_axis_variable or not args.t_axis_variable.strip():
        report_error_and_exit('t_axis_variable cannot be empty', rank)

    if not args.output_file or not args.output_file.strip():
        report_error_and_exit('output_file cannot be empty', rank)

    # Validate file layout and steps
    if args.file_layout == 'number_of_steps' and args.steps_per_file <= 0:
        report_error_and_exit(
            'steps_per_file must be positive when using number_of_steps layout',
            rank)

    if args.first_step < 0:
        report_error_and_exit('first_step cannot be negative', rank)

    if args.last_step != -1 and args.last_step < args.first_step:
        report_error_and_exit('last_step must be >= first_step or -1', rank)

    # Latitude values must be positive (absolute values) and in valid range
    if args.min_latitude < 0 or args.min_latitude > 90:
        report_error_and_exit('min_latitude must be in range [0, 90]', rank)

    if args.max_latitude < 0 or args.max_latitude > 90:
        report_error_and_exit('max_latitude must be in range [0, 90]', rank)

    if args.min_latitude >= args.max_latitude:
        report_error_and_exit('min_latitude must be < max_latitude', rank)

    if args.min_area <= 0:
        report_error_and_exit('min_area must be positive', rank)

    if args.pressure_level <= 0:
        report_error_and_exit('pressure_level must be positive', rank)

    if args.n_threads < 1 and args.n_threads != -1:
        report_error_and_exit('n_threads must be >1 (or -1 for one thread per'
                              ' physical core)', rank)


def create_input_reader(args):
    """
    Configure and return the input data reader.

    Parameters
    ----------
    args : argparse.Namespace
        Command-line arguments containing input configuration

    Returns
    -------
    reader : teca.teca_cf_reader or teca.teca_multi_cf_reader
        Configured reader for input data
    """
    if args.input_file:
        reader = teca.teca_multi_cf_reader.New()
        reader.set_input_file(args.input_file)
    else:
        reader = teca.teca_cf_reader.New()
        reader.set_files_regex(args.input_regex)

    reader.set_x_axis_variable(args.x_axis_variable)
    reader.set_y_axis_variable(args.y_axis_variable)
    reader.set_z_axis_variable(args.z_axis_variable)
    reader.set_t_axis_variable(args.t_axis_variable)
    reader.set_periodic_in_x(True)
    # Note: teca_cf_reader has set_periodic_in_y(),
    # but teca_multi_cf_reader does not
    if hasattr(reader, 'set_periodic_in_y'):
        reader.set_periodic_in_y(False)

    if args.calendar:
        reader.set_calendar(args.calendar)
    if args.t_units:
        reader.set_t_units(args.t_units)

    return reader


def create_writer(args, input_node, mask_varname, component_varname):
    """
    Configure and return the NetCDF writer.

    Parameters
    ----------
    args : argparse.Namespace
        Writer configuration parameters
    input_node : teca.teca_algorithm
        Input connection from pipeline
    mask_varname : str
        Name of mask variable
    component_varname : str
        Name of component variable

    Returns
    -------
    writer : teca.teca_cf_writer
        Configured writer ready to execute
    """

    exe = teca.teca_index_executive.New()
    writer = teca.teca_cf_writer.New()
    writer.set_input_connection(input_node.get_output_port())
    writer.set_executive(exe)
    writer.set_thread_pool_size(args.n_threads)
    writer.set_file_name(args.output_file)
    writer.set_layout(args.file_layout)
    writer.set_steps_per_file(args.steps_per_file)
    writer.set_first_step(args.first_step)
    writer.set_last_step(args.last_step)

    # Determine output arrays
    output_arrays = [component_varname]
    if args.save_mask:
        output_arrays += [mask_varname]
    writer.set_point_arrays(output_arrays)

    if args.date_format:
        writer.set_date_format(args.date_format)

    return writer


def build_blocking_event_detection_pipeline(args, rank):
    """
    Build the complete blocking event detection pipeline.

    Parameters
    ----------
    args : argparse.Namespace
        Configuration from command line
    rank : int
        MPI rank

    Returns
    -------
    writer : teca.teca_cf_writer
        Configured pipeline ready to execute
    """
    # Setup reader
    input_reader = create_input_reader(args)

    # Normalize coordinates
    normalize_input_coordinates = teca.teca_normalize_coordinates.New()
    normalize_input_coordinates.set_input_connection(
        input_reader.get_output_port())

    # Create and initialize blocking event detector
    detect_blobs = teca_blocking_event_detect_blobs()
    detect_blobs.set_input_node(normalize_input_coordinates)
    if args.thresholds_file:
        detect_blobs.set_thresholds_filename(args.thresholds_file)
    if args.thresholds_regex:
        detect_blobs.set_thresholds_regex(args.thresholds_regex)
    detect_blobs.set_thresholds_x_axis_variable(args.x_axis_variable)
    detect_blobs.set_thresholds_y_axis_variable(args.y_axis_variable)
    detect_blobs.set_thresholds_t_axis_variable(args.t_axis_variable)
    detect_blobs.set_geopotential_height_variable(
        args.geopotential_height_variable)
    detect_blobs.set_geopotential_height_threshold_variable(
        args.geopotential_height_threshold_variable)
    detect_blobs.set_pressure_level(args.pressure_level)
    detect_blobs.set_min_latitude(args.min_latitude)
    detect_blobs.set_max_latitude(args.max_latitude)
    detect_blobs.set_min_area(args.min_area)
    detect_blobs.set_discard_unique_region_ids(args.discard_unique_region_ids)

    # Configure the writer
    writer = create_writer(
        args, detect_blobs.get_output_node(), detect_blobs.get_mask_variable_name(),
        detect_blobs.get_blocking_event_variable_name())

    return writer


def main():
    """Main entry point for blocking event detection."""
    # Create parser and parse arguments
    parser = create_argument_parser()

    # Only MPI rank 0 prints parse errors to avoid clutter
    try:
        args = parser.parse_args()
    except Exception:
        if rank == 0:
            raise
        sys.exit(-1)

    # Validate configuration
    validate_arguments(args, rank)

    # Build and run pipeline
    pipeline = build_blocking_event_detection_pipeline(args, rank)
    pipeline.update()


if __name__ == '__main__':
    main()
