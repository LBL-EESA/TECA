#!/usr/bin/env python@TECA_PYTHON_VERSION@

try:
    from mpi4py import MPI
    comm = MPI.COMM_WORLD
    rank = comm.Get_rank()
except ImportError:
    rank = 0

import argparse
import sys
import teca
from teca_blocking_event_operations import IntersectRegionsOp

# parse the command line
parser = argparse.ArgumentParser(
    formatter_class=lambda prog: argparse.ArgumentDefaultsHelpFormatter(
                       prog, max_help_position=4, width=100))

input_group = parser.add_mutually_exclusive_group(required=True)
input_group.add_argument('--input_file', type=str,
    help='a teca_multi_cf_reader configuration file identifying the set'
         ' of NetCDF CF2 files to process. When present data is read'
         ' using the teca_multi_cf_reader. Use one of either --input_file'
         ' or --input_regex.')

input_group.add_argument('--input_regex', type=str,
    help='a teca_cf_reader regex identifying the'
         ' set of NetCDF CF2 files to process. When present data is read'
         ' using the teca_cf_reader. Use one of either --input_file or '
         ' --input_regex.')

parser.add_argument('--blocking_event_id_variable', type=str,
    required=False, default='blocking_event_id', help='name of variable with blocking event ID')

parser.add_argument('--x_axis_variable', type=str, default='lon',
    required=False, help='name of x coordinate variable')

parser.add_argument('--y_axis_variable', type=str, default='lat',
     required=False, help='name of y coordinate variable')

#parser.add_argument('--z_axis_variable', type=str, default='lev',
#     required=False, help='name of z coordinate variable')

parser.add_argument('--t_axis_variable', type=str, default = 'time',
     required=False, help='time dimension name')

parser.add_argument('--output_file', type=str, required=True,
    help='A path and file name pattern for the output NetCDF files. %%t%% is'
         ' replaced with a human readable date and time corresponding to the'
         ' time of the first time step in the file. Use --date_format to change'
         ' the formatting')

parser.add_argument('--file_layout', type=str, default='monthly',
                    help='Selects the size and layout of the set of output'
                         ' files. May be one of number_of_steps, daily,'
                         ' monthly, seasonal, or yearly. Files are structured'
                         ' such that each file contains one of the selected'
                         ' interval. For the number_of_steps option use'
                         ' --steps_per_file.')

parser.add_argument('--steps_per_file', type=int, required=False, default=128,
    help='number of time steps per output file')

parser.add_argument('--date_format', type=str, required=False,
    help='A strftime format used when encoding dates into the output'
         ' file names (%%F-%%HZ). %%t%% in the file name is replaced with date/time'
         ' of the first time step in the file using this format specifier.')

parser.add_argument('--first_step', type=int, default=0, required=False,
    help='first time step to process')

parser.add_argument('--last_step', type=int, default=-1, required=False,
    help='last time step to process')

parser.add_argument('--calendar', type=str, required=False,
    help='time calendar')

parser.add_argument('--t_units', type=str, required=False,
    help='time unit')

# Only MPI rank 0 prints to avoid clutter.
try:
    args = parser.parse_args()
except Exception:
    if rank == 0: raise

# Configure the reader for the data to be processed

if args.input_file and not args.input_regex:
    reader = teca.teca_multi_cf_reader.New()
    reader.set_input_file(args.input_file)
elif args.input_regex and not args.input_file:
    reader = teca.teca_cf_reader.New()
    reader.set_files_regex(args.input_regex)

reader.set_x_axis_variable(args.x_axis_variable)
reader.set_y_axis_variable(args.y_axis_variable)
#reader.set_z_axis_variable(args.z_axis_variable)
reader.set_t_axis_variable(args.t_axis_variable)

if args.calendar:
    reader.set_calendar(args.calendar)

if args.t_units:
    reader.set_t_units(args.t_units)

# Normalize the coordinates of the input data
normalize_input_coords = teca.teca_normalize_coordinates.New()
normalize_input_coords.set_input_connection(reader.get_output_port())

input_md = normalize_input_coords.update_metadata()

# TODO/FIXME: Figure out a good way to determine index ranges for the two
# reindexing operations.
input_coords = input_md['coordinates']
t = input_coords['t']
first_step = args.first_step
# We are considering time steps as pairs, so the last step is the second to
# last time step.
last_step = args.last_step if args.last_step >= 0 else t.size - 2

# First experiment: Try to do two different re-indexing operations using the
# same reader
# TODO/FIXME: Figure out if one reader is sufficient and can serve as input of
# reindexing operation as well as regular pipeline.
# ... Shift by one time step to get the next time step; timestep range is
#     inclusive, so need to add one to last_step
indices_next = range(first_step + 1, last_step + 1 + 1) 
reindex_next = teca.teca_temporal_index_select.New()
reindex_next.set_input_connection(normalize_input_coords.get_output_port())
reindex_next.set_indices(indices_next)

# Rename the blocking event ID variable for the next time step
rename_var = teca.teca_rename_variables.New()
rename_var.set_original_variable_names([args.blocking_event_id_variable])
rename_var.set_new_variable_names([args.blocking_event_id_variable + '_next'])
rename_var.set_input_connection(reindex_next.get_output_port())

# Join the two time steps into one dataset
mesh_join = teca.teca_mesh_join.New()
mesh_join.set_input_connection(0, normalize_input_coords.get_output_port())
mesh_join.set_input_connection(1, rename_var.get_output_port())

# Compute the intersection of the blocking events in the two time steps
intersect_blobs = teca.teca_derived_quantity.New()
intersect_blobs.set_operation_name('intersect_blobs')
intersect_blobs.set_input_connection(mesh_join.get_output_port())
dependent_vars = [args.blocking_event_id_variable, args.blocking_event_id_variable + '_next']
intersection_varname = args.blocking_event_id_variable + '_intersection'
intersect_blobs.set_dependent_variables(dependent_vars)
mesh_join_md = mesh_join.update_metadata()
in_atts = teca.teca_array_attributes(mesh_join_md['attributes'][dependent_vars[0]])
out_atts = teca.teca_array_attributes(teca.teca_int_array_code.get(),
                                      teca.teca_array_attributes.point_centering,
                                      0, in_atts.mesh_dim_active, 'unitless',
                                      intersection_varname,
                                      'intersection of labelbed regions', None)
intersect_blobs.append_derived_variable(intersection_varname, out_atts)
intersect_blobs_op = IntersectRegionsOp(
    args.blocking_event_id_variable,
    args.blocking_event_id_variable + '_next',
    0, # Background value
    intersection_varname)
intersect_blobs.set_execute_callback(intersect_blobs_op)

# Compute the area blobs in current time step
prev_blob_area = teca.teca_2d_component_area.New()
prev_blob_area.set_input_connection(intersect_blobs.get_output_port())
prev_blob_area.set_component_variable(args.blocking_event_id_variable)
prev_blob_area.set_background_id(0) # TODO/FIXME: Make this configurable? Save metadata in file?
prev_blob_area.set_output_metadata_prefix('prev_blob_')

# Compute the area of the intersections of blobs between time steps
intersection_area = teca.teca_2d_component_area.New()
intersection_area.set_input_connection(prev_blob_area.get_output_port())
intersection_area.set_component_variable(intersection_varname)
intersection_area.set_background_id(0) # TODO/FIXME: Make this configurable? Save metadata in file?
intersection_area.set_output_metadata_prefix('intersection_')

# Compute the area blobs in next time step -> Only needed if we want to filter
# based on overlap with next time step as well
#next_blob_area = teca_2d_component_area.New()
#next_blob_area.set_input_connection(intersection_area.get_output_port())
#next_blob_area.set_component_variable(args.blocking_event_id_variable + '_next')
#next_blob_area.set_background_id(0) # TODO/FIXME: Make this configurable? Save metadata in file?
#next_blob_area.set_output_metadata_prefix('next_blob_')

# TODO/FIXME: This class should be moved to a separate file
class generate_tracking_matches_table_algorithm(teca.teca_python_algorithm):
    def __init__(self):
        super(generate_tracking_matches_table_algorithm, self).__init__()
        self.verbose = False
        self.prev_blob_prefix = "prev_blob_"
        self.intersection_prefix = "intersection_"
        self.min_overlap_fraction_prev = 0

    def set_verbose(self, verbose : bool = True):
        """ Set the verbosity flag controlling the printing of diagnostic messages """
        self.verbose = verbose

    def set_prev_blob_prefix(self, prefix : str):
        """ Set the prefix used to identify the previous blob area arrays in the metadata """
        self.prev_blob_prefix = prefix

    def set_intersection_prefix(self, prefix : str):
        """ Set the prefix used to identify the intersection area arrays in the metadata """
        self.intersection_prefix = prefix

    def set_min_overlap_prev(self, min_overlap_prev : float):
        """ Set the minimum required overlap percentage with previous time step to be included in the table """
        self.min_overlap_fraction_prev = min_overlap_prev / 100.

    def vprint(self, *args, **kwargs):
        """ Print only if verbose is set"""
        if self.verbose:
            print(*args, **kwargs)

    # TODO/FIXME: This class seems to be working without request/report methods, but
    # not sure why. Do we need to implement these anyway?

    def execute(self, port, data_in, req_in):
        #in_mesh = as_teca_cartesian_mesh(data_in[0])
        #in_metadata = in_mesh.get_metadata()

        # Get the current time index
        index_request_key = req_in['index_request_key']
        index_request = req_in[index_request_key]
        t_index = index_request[0]
        # ... double check that only one index was requested
        if t_index != index_request[1]:
            raise NotImplementedError('generate_overlap_table::execute: only one time index can be requested at a time')

        # Get areas of previous blobs and intersection blobs from metadata
        in_metadata = data_in[0].get_metadata()
        prev_blob_component_ids = in_metadata[self.prev_blob_prefix + 'component_ids']
        prev_blob_component_areas = in_metadata[self.prev_blob_prefix + 'component_area']
        prev_blob_area_dict = dict(zip(prev_blob_component_ids, prev_blob_component_areas))
        self.vprint(prev_blob_component_ids)
        self.vprint(prev_blob_component_areas)
        self.vprint(prev_blob_area_dict)
        intersection_component_ids = in_metadata[self.intersection_prefix + 'component_ids']
        intersection_component_areas = in_metadata[self.intersection_prefix + 'component_area']
        self.vprint(intersection_component_ids)
        self.vprint(intersection_component_areas)

        # Find pairs of regions with sufficient overlap
        # Note: The intersection component ids are encoded as (next_blob_id << 16) | prev_blob_id
        region_matches = [
            (x & 0xFFFF, x >> 16)
            for x, overlap_area in zip(intersection_component_ids, intersection_component_areas)
            if x!=0 and overlap_area / prev_blob_area_dict[x&0xFFFF] > self.min_overlap_fraction_prev ]
        self.vprint(region_matches)

        # Create and return the output table
        out_table = teca.teca_table.New()
        out_table.copy_metadata(data_in[0])
        out_table.declare_columns(['time_index_1', 'region_id_1', 'time_inde_x2', 'region_id_2'], ['ul', 'ul', 'ul', 'ul'] )
        for region_id_1, region_id_2 in region_matches:
            out_table << t_index << region_id_1 << t_index + 1 << region_id_2
        return out_table

generate_tracking_matches_table = generate_tracking_matches_table_algorithm.New()
generate_tracking_matches_table.set_input_connection(intersection_area.get_output_port())
generate_tracking_matches_table.set_min_overlap_prev(20)
generate_tracking_matches_table.set_verbose()
generate_tracking_matches_table.update()

# Create the table reducer
table_reduce = teca.teca_table_reduce.New()
table_reduce.set_thread_pool_size(1) # only one thread
table_reduce.set_input_connection(generate_tracking_matches_table.get_output_port())
table_reduce.set_start_index(first_step)
table_reduce.set_end_index(last_step)
table_reduce.set_verbose(True)

# Create the table sorter
table_sorter = teca.teca_table_sort.New()
table_sorter.set_input_connection(table_reduce.get_output_port())
table_sorter.set_index_column("time_index_1")

# Create the table writer
table_writer = teca.teca_table_writer.New()
table_writer.set_input_connection(table_sorter.get_output_port())
table_writer.set_file_name("tracking_info_%t%.csv")

# Run the pipeline
table_writer.update()

sys.exit(0)

# Configure the writer
exe = teca_index_executive.New()
writer = teca_cf_writer.New()
#writer.set_input_connection(intersect_blobs.get_output_port())
writer.set_input_connection(tabulate_areas.get_output_port())
writer.set_executive(exe)
writer.set_thread_pool_size(1)
writer.set_file_name(args.output_file)
writer.set_layout(args.file_layout)
writer.set_steps_per_file(args.steps_per_file)
writer.set_first_step(first_step)
writer.set_last_step(last_step)
writer.set_point_arrays([args.blocking_event_id_variable, args.blocking_event_id_variable + '_next', intersection_varname])
if args.date_format:
   writer.set_date_format(args.date_format)

writer.update()

