#!/usr/bin/env python@TECA_PYTHON_VERSION@
import sys
import numpy as np

def main():
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <array1.npy> <array2.npy>")
        sys.exit(1)

    arr1_path = sys.argv[1]
    arr2_path = sys.argv[2]

    try:
        arr1 = np.load(arr1_path)
        arr2 = np.load(arr2_path)
    except Exception as e:
        print(f"ERROR: Failed to load arrays: {e}")
        sys.exit(1)

    if arr1.shape != arr2.shape:
        print(f"ERROR: Shape mismatch: {arr1.shape} vs {arr2.shape}")
        sys.exit(1)

    if np.array_equal(arr1, arr2):
        print("SUCCESS: Arrays are equal")
    else:
        # Find first differing element
        diff_indices = np.argwhere(arr1 != arr2)
        idx = tuple(diff_indices[0])
        print(f"ERROR: Arrays differ at index {idx}: {arr1[idx]} != {arr2[idx]}")
        sys.exit(1)

if __name__ == "__main__":
    main()